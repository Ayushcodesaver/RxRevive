# ============================================================
# RxRevive monorepo environment configuration
# Copy to the matching .env files and fill in real values.
# Nothing here contains credentials; see BUILD_STATUS.md for
# which integration needs which key.
# ============================================================

# --- Clerk (authentication) ------------------------------------------
# From dashboard.clerk.com -> API keys. Needed by web/.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# The issuer domain of Clerk JWTs, e.g. https://your-app.clerk.accounts.dev
# Needed by ai-backend/ to verify tokens (no trailing slash).
CLERK_JWT_ISSUER_DOMAIN=

# --- Convex (database) ------------------------------------------------
# From npx convex dev. Needed by web/.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# --- Python AI service -------------------------------------------------
# Where web/ finds the FastAPI service.
PYTHON_API_URL=http://127.0.0.1:8000
# Shared secret for server-to-server calls (generate one: python -c "import secrets; print(secrets.token_hex(32))").
# Leave empty in local dev; the backend then runs with AUTH_DISABLED=true.
PYTHON_API_SECRET=

# --- Object storage (Cloudflare R2 or AWS S3; optional) ----------------
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=

# --- Background processing (optional) -----------------------------------
REDIS_URL=

# --- Model ---------------------------------------------------------------
MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MODEL_DEVICE=auto

# --- Deployment ------------------------------------------------------------
# AI backend CORS: comma-separated web origins (add your vercel.app domain)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
